{% extends "layout/login-layout" %}

{% block styles %}
    {{ super() }}
    <link href="static/css/compiled/login.css" type="text/css" rel="stylesheet">
{% endblock %}

{% block content %}
    <form class="login__form" method="POST">
        <div class="login__header">Budget Manager</div>
        <div class="login__input-container">
            <label for="username"></label>
            <input type="text" class="login__input" id="username" name="username" placeholder="Username"/>
        </div>
        <div class="login__input-container">
            <label for="password"></label>
            <input type="password" class="login__input" id="password" name="password" placeholder="Password"/>
        </div>
        <div class="login__input-container login__input-container--submit">
            <input type="submit" class="button" value="Login"/>
        </div>
    </form>
{% endblock %}
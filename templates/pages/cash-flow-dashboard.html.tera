{% extends "layout/general-layout" %}

{% block styles %}
    {{ super() }}
    <link href="static/css/compiled/cash-flow-dashboard.css" type="text/css" rel="stylesheet">
{% endblock %}

{% block content %}
    <h1>Cash Flow Dashboard -
        {% for month_entry in month_range %}
            {% if month_entry.1 == month %}
                {{ month_entry.0 }}
            {% endif %}
        {% endfor %}
        {{ year }}
    </h1>

    <form class="date-change-form">
        <select name="month" class="date-change-form__select">
            {% for month_entry in month_range %}
            <option value="{{ month_entry.1 }}" {% if month_entry.1 == month %}selected{% endif %}>{{ month_entry.0 }}</option>
            {% endfor %}
        </select>
        <select name="year" class="date-change-form__select">
            {% for year_entry in range(start=year_range_start, end=year_range_end + 1) %}
            <option value="{{ year_entry }}" {% if year_entry == year %}selected{% endif %}>{{ year_entry }}</option>
            {% endfor %}
        </select>
        <input type="submit" class="button" value="Submit">
    </form>

    <div style="height: 50%; width: 40%;">
        <canvas id="income-budget-chart"></canvas>
    </div>
{% endblock %}

{% block scripts %}
    {{ super() }}
    <script>
        window._year = {{ year }};
        window._month = {{ month }};
    </script>
    <script type="text/javascript" src="static/javascript/pages/cash-flow-dashboard.js"></script>
{% endblock %}
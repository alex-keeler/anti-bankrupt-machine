{% extends "layout/general-layout" %}

{% block content %}
    <form class="form form--small" enctype="multipart/form-data" method="POST">
        <div class="form__header">Bank Record Upload</div>
        <div class="form__entry">
            <label for="bank_account_select" class="form__label">Bank Account: </label>
            <select id="bank_account_select" name="bank_account_id" class="form__input" required>
                {% for account in accounts %}
                    <option value="{{ account.id }}">{{ account.title }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="form__entry">
            <label for="file_upload" class="form__label">File: </label>
            <input type="file" id="file_upload" name="file" class="form__input" required/>
        </div>
        <div class="form__entry form__entry--submit">
            <input type="submit" value="Upload" class="button"/>
        </div>
    </form>
{% endblock %}